@model _3TLPROJECTck.Data.KhachHang
@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<style>
    .profile-wrapper {
        min-height: 80vh;
        background: #f5f7fb;
        padding: 40px 0;
    }

    .profile-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        overflow: hidden;
        max-width: 700px;
        margin: 0 auto;
    }

    /* Header banner */
    .profile-header {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        padding: 36px 32px 60px;
        position: relative;
        text-align: center;
    }

        .profile-header h4 {
            color: #fff;
            font-size: 22px;
            font-weight: 700;
            margin: 0;
            letter-spacing: 0.3px;
        }

        .profile-header p {
            color: rgba(255,255,255,0.8);
            font-size: 13px;
            margin: 4px 0 0;
        }

    /* Avatar */
    .profile-avatar {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        border: 4px solid #fff;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        font-weight: 800;
        color: #0d6efd;
        position: absolute;
        bottom: -45px;
        left: 50%;
        transform: translateX(-50%);
        box-shadow: 0 4px 16px rgba(0,0,0,0.12);
        overflow: hidden;
    }

        .profile-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* Body */
    .profile-body {
        padding: 60px 32px 32px;
    }

    .profile-name {
        text-align: center;
        font-size: 20px;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 4px;
    }

    .profile-id {
        text-align: center;
        font-size: 13px;
        color: #888;
        margin-bottom: 28px;
    }

    /* Info rows */
    .info-section-title {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #0d6efd;
        margin-bottom: 12px;
        margin-top: 24px;
    }

    .info-row {
        display: flex;
        align-items: flex-start;
        padding: 12px 0;
        border-bottom: 1px solid #f0f0f5;
        gap: 12px;
    }

        .info-row:last-child {
            border-bottom: none;
        }

    .info-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: #eef2ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .info-content {
        flex: 1;
    }

    .info-label {
        font-size: 11px;
        color: #999;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-value {
        font-size: 15px;
        color: #1a1a2e;
        font-weight: 500;
        margin-top: 2px;
    }

        .info-value.empty {
            color: #bbb;
            font-style: italic;
            font-weight: 400;
        }

    /* Badge vai trò */
    .role-badge {
        display: inline-block;
        padding: 3px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

        .role-badge.customer {
            background: #e8f5e9;
            color: #2e7d32;
        }

        .role-badge.admin {
            background: #fff3e0;
            color: #e65100;
        }

    /* Status */
    .status-dot {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 14px;
        font-weight: 500;
    }

        .status-dot::before {
            content: '';
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #4caf50;
            display: inline-block;
        }

        .status-dot.inactive::before {
            background: #f44336;
        }

    /* Buttons */
    .profile-actions {
        display: flex;
        gap: 12px;
        margin-top: 28px;
    }

    .btn-logout {
        flex: 1;
        padding: 12px;
        border: 2px solid #fee2e2;
        background: #fff;
        color: #dc2626;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        text-align: center;
        text-decoration: none;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

        .btn-logout:hover {
            background: #fee2e2;
            color: #dc2626;
            text-decoration: none;
        }
</style>

<div class="profile-wrapper">
    <div class="container">
        <div class="profile-card">

            <!-- Header -->
            <div class="profile-header">
                <h4>Thông tin cá nhân</h4>
                <p>Quản lý thông tin tài khoản của bạn</p>

                <!-- Avatar -->
                <div class="profile-avatar">
                    @if (!string.IsNullOrEmpty(Model.Hinh))
                    {
                        <img src="~/images/KhachHang/@Model.Hinh" alt="Avatar" />
                    }
                    else
                    {
                        @(Model.HoTen?.Substring(0, 1).ToUpper() ?? "U")
                    }
                </div>
            </div>

            <!-- Body -->
            <div class="profile-body">
                <!-- Tên & Mã KH -->
                <div class="profile-name">@Model.HoTen</div>
                <div class="profile-id">Mã khách hàng: <strong>@Model.MaKh</strong></div>

                <!-- Thông tin cơ bản -->
                <div class="info-section-title">📋 Thông tin cơ bản</div>

                <div class="info-row">
                    <div class="info-icon">👤</div>
                    <div class="info-content">
                        <div class="info-label">Họ tên</div>
                        <div class="info-value">@Model.HoTen</div>
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-icon">📧</div>
                    <div class="info-content">
                        <div class="info-label">Email</div>
                        <div class="info-value @(string.IsNullOrEmpty(Model.Email) ? "empty" : "")">
                            @(string.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)
                        </div>
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-icon">📱</div>
                    <div class="info-content">
                        <div class="info-label">Điện thoại</div>
                        <div class="info-value @(string.IsNullOrEmpty(Model.DienThoai) ? "empty" : "")">
                            @(string.IsNullOrEmpty(Model.DienThoai) ? "Chưa cập nhật" : Model.DienThoai)
                        </div>
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-icon">📍</div>
                    <div class="info-content">
                        <div class="info-label">Địa chỉ</div>
                        <div class="info-value @(string.IsNullOrEmpty(Model.DiaChi) ? "empty" : "")">
                            @(string.IsNullOrEmpty(Model.DiaChi) ? "Chưa cập nhật" : Model.DiaChi)
                        </div>
                    </div>
                </div>

                <!-- Thông tin tài khoản -->
                <div class="info-section-title">🔐 Tài khoản</div>

                <div class="info-row">
                    <div class="info-icon">🏷️</div>
                    <div class="info-content">
                        <div class="info-label">Vai trò</div>
                        <div class="info-value">
                            @if (Model.VaiTro == 0)
                            {
                                <span class="role-badge customer">Khách hàng</span>
                            }
                            else
                            {
                                <span class="role-badge admin">Quản trị viên</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-icon">✅</div>
                    <div class="info-content">
                        <div class="info-label">Trạng thái</div>
                        <div class="info-value">
                            <span class="status-dot @(!Model.HieuLuc ? "inactive" : "")">
                                @(Model.HieuLuc ? "Đang hoạt động" : "Không hoạt động")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Nút hành động -->
                <div class="profile-actions">
                    <a class="btn-logout" asp-controller="KhachHang" asp-action="DangXuat">
                        🚪 Đăng xuất
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
