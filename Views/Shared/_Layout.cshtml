<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - _3TLPROJECTck</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_3TLPROJECTck.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <!-- Brand / Logo -->
                <a class="navbar-brand fw-bold text-primary" asp-controller="HangHoa" asp-action="Index">🛍️ 3TL Shop</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- Nav links bên trái -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="HangHoa" asp-action="Index">Sản phẩm</a>
                        </li>
                    </ul>

                    <!-- Bên phải: Avatar hoặc Đăng nhập -->
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Đã đăng nhập: hiện avatar + dropdown -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 p-0"
                                   href="#" id="userDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <!-- Avatar vòng tròn với chữ cái đầu -->
                                    <div style="width:38px; height:38px; border-radius:50%;
                                                    background:#0d6efd; color:#fff;
                                                    display:flex; align-items:center; justify-content:center;
                                                    font-size:16px; font-weight:bold; flex-shrink:0;">
                                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <span class="d-none d-md-inline" style="font-size:14px; color:#333;">
                                        @User.Identity.Name
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow"
                                    aria-labelledby="userDropdown"
                                    style="min-width:200px; border-radius:10px; overflow:hidden;">
                                    <!-- Header dropdown -->
                                    <li class="px-3 py-2 text-center border-bottom bg-light">
                                        <div style="width:48px; height:48px; border-radius:50%;
                                                        background:#0d6efd; color:#fff;
                                                        display:flex; align-items:center; justify-content:center;
                                                        font-size:20px; font-weight:bold; margin:0 auto 6px;">
                                            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                        </div>
                                        <strong style="font-size:13px;">@User.Identity.Name</strong>
                                    </li>
                                    <!-- Thông tin cá nhân -->
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="KhachHang" asp-action="Profile">
                                            👤 &nbsp;Thông tin cá nhân
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1" /></li>
                                    <!-- Lịch sử mua hàng -->
                                    <li>
                                        <a class="dropdown-item py-2"
                                           asp-controller="DonHang"
                                           asp-action="LichSuMuaHang">
                                            🛒 &nbsp;Lịch sử mua hàng
                                        </a>
                                    </li>
                                    <!-- Đăng xuất -->
                                    <li>
                                        <a class="dropdown-item py-2 text-danger fw-semibold"
                                           asp-controller="KhachHang" asp-action="DangXuat">
                                            🚪 &nbsp;Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- Chưa đăng nhập: hiện nút Đăng nhập -->
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-1"
                                   asp-controller="KhachHang" asp-action="DangNhap">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                         fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4z" />
                                    </svg>
                                    <span>Đăng nhập</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - _3TLPROJECTck - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
