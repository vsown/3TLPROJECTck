@{
    Layout = "_LayoutCustomer";
}
@RenderSection("BreadCrumb", required: false)


<div class="site-section pt-3">
    <div class="container">

        <div class="row mb-5">

            <!-- SIDEBAR: Danh mục + Filter (cột trái)  -->
            <div class="col-md-3 order-1 mb-5 mb-md-0">
                <form method="get" asp-action="Index" asp-controller="HangHoa" id="filterForm">
                    <input type="hidden" name="loai" value="@ViewBag.Loai" />
                    <input type="hidden" name="page" value="1" />
                    <input type="hidden" name="sapXep" value="@ViewBag.SapXep" />

                    <!-- DANH MỤC -->
                    <div class="border p-4 rounded mb-4">
                        <h3 class="mb-3 h6 text-uppercase text-black d-block">Danh Mục</h3>
                        @await Component.InvokeAsync("MenuLoai")
                    </div>

                    <!-- FILTER GIÁ -->
                    <div class="border p-4 rounded mb-4">
                        <div class="mb-4">
                            <h3 class="mb-3 h6 text-uppercase text-black d-block">Filter by Price</h3>
                            <div id="slider-range"></div>
                            <div class="d-flex justify-content-between mt-2">
                                <span id="amount-min">@ViewBag.MinGia.ToString("N0")₫</span>
                                <span id="amount-max">@ViewBag.MaxGia.ToString("N0")₫</span>
                            </div>
                            <input type="hidden" name="minGia" id="minGia" value="@ViewBag.MinGia" />
                            <input type="hidden" name="maxGia" id="maxGia" value="@ViewBag.MaxGia" />
                        </div>

                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            Lọc sản phẩm
                        </button>
                    </div>
                </form>
            </div>

            <!-- MAIN CONTENT: Tiêu đề + Sắp xếp + Sản phẩm (cột phải)  -->
            <div class="col-md-9 order-2">

                <!-- Thanh tiêu đề + Sắp xếp -->
                <div class="row mb-2">
                    <div class="col-md-12">
                        <div class="d-flex align-items-center justify-content-between flex-wrap">
                            <h2 class="text-black h5 mb-0">Tất Cả Sản Phẩm</h2>
                            <div class="dropdown">
                                <button type="button" class="btn btn-secondary btn-sm dropdown-toggle"
                                        data-toggle="dropdown">
                                    Sắp xếp
                                </button>
                                <div class="dropdown-menu dropdown-menu-right">
                                    <a class="dropdown-item" href="?loai=@ViewBag.Loai&sapXep=name_az">Tên A → Z</a>
                                    <a class="dropdown-item" href="?loai=@ViewBag.Loai&sapXep=name_za">Tên Z → A</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" href="?loai=@ViewBag.Loai&sapXep=gia_tang">Giá thấp → cao</a>
                                    <a class="dropdown-item" href="?loai=@ViewBag.Loai&sapXep=gia_giam">Giá cao → thấp</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" href="?loai=@ViewBag.Loai">Mới nhất</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Danh sách sản phẩm -->
                <div class="row g-4 justify-content-center mb-5">
                    @RenderBody()
                </div>

            </div>
            <!-- end col-md-9  -->

        </div>
        <!-- end row mb-5  -->
        <!-- Section Categories bên dưới -->
        <div class="row">
            <div class="col-md-12">
                <div class="site-section site-blocks-2">
                    <div class="row justify-content-center text-center mb-5">
                        <div class="col-md-7 site-section-heading pt-4">
                            <h2>Categories</h2>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6 col-md-6 col-lg-4 mb-4 mb-lg-0" data-aos="fade" data-aos-delay="">
                            <a class="block-2-item" href="#">
                                <figure class="image">
                                    <img src="images/women.jpg" alt="" class="img-fluid">
                                </figure>
                                <div class="text">
                                    <span class="text-uppercase">Collections</span>
                                    <h3>Women</h3>
                                </div>
                            </a>
                        </div>
                        <div class="col-sm-6 col-md-6 col-lg-4 mb-5 mb-lg-0" data-aos="fade" data-aos-delay="100">
                            <a class="block-2-item" href="#">
                                <figure class="image">
                                    <img src="images/children.jpg" alt="" class="img-fluid">
                                </figure>
                                <div class="text">
                                    <span class="text-uppercase">Collections</span>
                                    <h3>Children</h3>
                                </div>
                            </a>
                        </div>
                        <div class="col-sm-6 col-md-6 col-lg-4 mb-5 mb-lg-0" data-aos="fade" data-aos-delay="200">
                            <a class="block-2-item" href="#">
                                <figure class="image">
                                    <img src="images/men.jpg" alt="" class="img-fluid">
                                </figure>
                                <div class="text">
                                    <span class="text-uppercase">Collections</span>
                                    <h3>Men</h3>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/themes/base/jquery-ui.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/jquery-ui.min.js"></script>
    <script>
        $(function () {
            $("#slider-range").slider({
                range: true,
                min: 0,
                max: 5000000,
                values: [@ViewBag.MinGia, @ViewBag.MaxGia == 0 ? 5000000 : @ViewBag.MaxGia],
                slide: function (event, ui) {
                    $("#amount-min").text(ui.values[0].toLocaleString('vi-VN') + "₫");
                    $("#amount-max").text(ui.values[1].toLocaleString('vi-VN') + "₫");
                    $("#minGia").val(ui.values[0]);
                    $("#maxGia").val(ui.values[1]);
                }
            });
            var min = $("#slider-range").slider("values", 0);
            var max = $("#slider-range").slider("values", 1);
            $("#amount-min").text(min.toLocaleString('vi-VN') + "₫");
            $("#amount-max").text(max.toLocaleString('vi-VN') + "₫");
        });
    </script>
}
