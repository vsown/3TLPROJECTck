@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using _3TLPROJECTck.Models 
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Đặt Hàng Thành Công";

    var hoTen = TempData["HoTen"];
    var diaChi = TempData["DiaChi"];
    var dienThoai = TempData["DienThoai"];
    var ngayDat = TempData["NgayDat"];
    var tongTien = TempData["TongTien"];
    var thanhToan = TempData["ThanhToan"];
    var vanChuyen = TempData["VanChuyen"];
}
@{
    var json = Context.Session.GetString("LichSuDonHang");

    List<DonHangHistory> lichSu = string.IsNullOrEmpty(json)
        ? new List<DonHangHistory>()
        : JsonSerializer.Deserialize<List<DonHangHistory>>(json);

    lichSu.Add(new DonHangHistory
    {
        HoTen = hoTen?.ToString(),
        DiaChi = diaChi?.ToString(),
        DienThoai = dienThoai?.ToString(),
        NgayDat = ngayDat?.ToString(),
        TongTien = tongTien?.ToString(),
        ThanhToan = thanhToan?.ToString(),
        VanChuyen = vanChuyen?.ToString()
    });

    Context.Session.SetString(
        "LichSuDonHang",
        JsonSerializer.Serialize(lichSu)
    );
}

<style>
    .success-wrapper {
        background: linear-gradient(to bottom right, #f8fbff, #eef5ff);
        min-height: 100vh;
        padding: 60px 0;
    }

    .success-card {
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 123, 255, 0.12);
        border: none;
    }

    .success-header {
        background: linear-gradient(135deg, #0d6efd, #3d8bfd);
        padding: 45px 30px;
        text-align: center;
        color: white;
    }

    .success-icon {
        width: 110px;
        height: 110px;
        background: rgba(255,255,255,0.15);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        font-size: 55px;
        border: 4px solid rgba(255,255,255,0.3);
    }

    .success-title {
        font-size: 32px;
        font-weight: 700;
        margin-top: 20px;
    }

    .success-subtitle {
        opacity: 0.9;
        font-size: 16px;
    }

    .order-info {
        padding: 35px;
    }

    .info-title {
        font-size: 22px;
        font-weight: 700;
        color: #0d6efd;
        margin-bottom: 25px;
        border-left: 5px solid #0d6efd;
        padding-left: 15px;
    }

    .info-item {
        padding: 14px 0;
        border-bottom: 1px dashed #dee2e6;
    }

    .info-label {
        color: #6c757d;
        font-weight: 500;
    }

    .info-value {
        font-weight: 600;
        color: #212529;
    }

    .total-box {
        background: #f1f7ff;
        border-radius: 15px;
        padding: 20px;
        margin-top: 25px;
    }

    .total-price {
        color: #dc3545;
        font-size: 32px;
        font-weight: 700;
    }

    .action-buttons .btn {
        min-width: 180px;
        padding: 12px 20px;
        border-radius: 10px;
        font-weight: 600;
        transition: 0.3s;
    }

    .btn-primary {
        background: linear-gradient(135deg, #0d6efd, #3d8bfd);
        border: none;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(13,110,253,0.3);
        }

    .btn-outline-primary:hover {
        transform: translateY(-2px);
    }

    .breadcrumb-custom a {
        color: #0d6efd;
        font-weight: 500;
        text-decoration: none;
    }

    .breadcrumb-custom {
        margin-bottom: 30px;
    }

    @@media (max-width: 768px) {
        .success-title {
            font-size: 24px;
        }

        .order-info {
            padding: 25px 20px;
        }

        .action-buttons .btn {
            width: 100%;
            margin-bottom: 10px;
        }
    }
</style>

<div class="success-wrapper">

    <div class="container">

        <!-- Breadcrumb -->
        <div class="breadcrumb-custom">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span class="mx-2 text-muted">/</span>
            <span class="text-dark font-weight-bold">Đặt Hàng Thành Công</span>
        </div>

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="success-card">

                    <!-- Header -->
                    <div class="success-header">

                        <div class="success-icon">
                            ✔
                        </div>

                        <div class="success-title">
                            Đặt Hàng Thành Công
                        </div>

                        <div class="success-subtitle mt-2">
                            Cảm ơn bạn đã mua sắm cùng chúng tôi
                        </div>

                    </div>

                    <!-- Content -->
                    <div class="order-info">

                        <div class="info-title">
                            Thông Tin Đơn Hàng
                        </div>

                        <div class="row info-item">
                            <div class="col-md-4 info-label">
                                Người nhận
                            </div>

                            <div class="col-md-8 info-value">
                                @hoTen
                            </div>
                        </div>

                        <div class="row info-item">
                            <div class="col-md-4 info-label">
                                Số điện thoại
                            </div>

                            <div class="col-md-8 info-value">
                                @dienThoai
                            </div>
                        </div>

                        <div class="row info-item">
                            <div class="col-md-4 info-label">
                                Địa chỉ giao hàng
                            </div>

                            <div class="col-md-8 info-value">
                                @diaChi
                            </div>
                        </div>

                        <div class="row info-item">
                            <div class="col-md-4 info-label">
                                Ngày đặt
                            </div>

                            <div class="col-md-8 info-value">
                                @ngayDat
                            </div>
                        </div>

                        <div class="row info-item">
                            <div class="col-md-4 info-label">
                                Thanh toán
                            </div>

                            <div class="col-md-8 info-value">
                                @thanhToan
                            </div>
                        </div>

                        <div class="row info-item">
                            <div class="col-md-4 info-label">
                                Vận chuyển
                            </div>

                            <div class="col-md-8 info-value">
                                @vanChuyen
                            </div>
                        </div>

                        <!-- Total -->
                        <div class="total-box">

                            <div class="row align-items-center">

                                <div class="col-md-6">
                                    <div class="info-label mb-2">
                                        Tổng Thanh Toán
                                    </div>

                                    <div class="total-price">
                                        @tongTien ₫
                                    </div>
                                </div>

                                <div class="col-md-6 text-md-right mt-3 mt-md-0">
                                    <span class="badge badge-primary px-4 py-2"
                                          style="font-size:14px;">
                                        Đơn hàng đang xử lý
                                    </span>
                                </div>

                            </div>

                        </div>

                        <!-- Buttons -->
                        <div class="text-center mt-5 action-buttons">

                            <a asp-controller="HangHoa"
                               asp-action="Index"
                               class="btn btn-outline-primary mr-md-2">

                                Tiếp tục mua sắm

                            </a>

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-primary">

                                Về trang chủ

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>