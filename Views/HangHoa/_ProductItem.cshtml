@model _3TLPROJECTck.ViewModels.HangHoaVM

<div class="col-sm-6 col-lg-4 mb-4" data-aos="fade-up">

    <div class="card h-100 border-0 shadow-sm rounded overflow-hidden">

        <!-- Ảnh sản phẩm -->
        <div style="height:320px; overflow:hidden; position:relative;">

            <a asp-action="Detail"
               asp-controller="HangHoa"
               asp-route-id="@Model.MaHh">

                <img src="~/images/@Model.Hinh"
                     alt="@Model.TenHh"
                     class="w-100 h-100"
                     style="object-fit:cover; transition:0.3s;" />

            </a>

            <!-- Badge loại -->
            <span class="badge badge-dark position-absolute"
                  style="top:10px; left:10px; font-size:0.8rem; padding:8px 12px;">
                @Model.TenLoai
            </span>

        </div>

        <!-- Nội dung -->
        <div class="card-body d-flex flex-column">

            <!-- Tên -->
            <h5 class="card-title mb-2" style="min-height:48px;">

                <a asp-action="Detail"
                   asp-controller="HangHoa"
                   asp-route-id="@Model.MaHh"
                   class="text-dark font-weight-bold"
                   style="text-decoration:none;">

                    @Model.TenHh

                </a>

            </h5>

            <!-- Mô tả -->
            <p class="text-muted small flex-grow-1"
               style="min-height:45px;">

                @Model.MoTaNgan

            </p>

            <!-- Giá -->
            <div class="mb-3">

                <span class="text-danger font-weight-bold"
                      style="font-size:1.2rem;">

                    @Model.DonGia.ToString("#,##0") đ

                </span>

            </div>

            <!-- Button -->
            <a asp-action="AddToCart"
               asp-controller="Cart"
               asp-route-id="@Model.MaHh"
               class="btn btn-outline-primary btn-block rounded-pill">

                <i class="fa fa-shopping-cart mr-2"></i>
                Thêm vào giỏ hàng

            </a>

        </div>

    </div>

</div>